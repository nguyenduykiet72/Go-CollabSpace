# APPLICATION CONFIGURATION
PORT=
MODE=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FE_RETURN_URL_WHITELIST=http://localhost:3000/reset-password,http://localhost:3001/reset-password

# DATABASE CONFIGURATION
DB_HOST=your_db_host
DB_PORT=your_db_port
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT CONFIGURATION
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_ACCESS_DURATION=your_jwt_access_duration
JWT_REFRESH_DURATION=your_jwt_refresh_duration

# REDIS CONFIGURATION
REDIS_HOST=your_redis_host
REDIS_PORT=your_redis_port
REDIS_PASSWORD=your_redis_password

# AWS CONFIGURATION
AWS_REGION=your_aws_region
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=your_aws_bucket_name

# RESEND CONFIGURATION
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=your_resend_from_email

# SMTP CONFIGURATION
# Uncomment and fill in the following lines if you want to use SMTP for sending emails instead of Resend
#SMTP_HOST=your_smtp_host
#SMTP_PORT=your_smtp_port
#SMTP_USERNAME=your_smtp_user
#SMTP_PASSWORD=your_smtp_password
#SMTP_FROM=your_smtp_from_email

# OAUTH CONFIGURATION
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8123/auth/google/callback
